API_BASE_URL=https://lastochki.store/api/v1
DEFAULT_STORE_ID=2
# Canonical origin of this web application (e.g. https://lastochki.store or staging URL)
PUBLIC_ORIGIN=http://localhost:3000
# Domain registered in merchant YooKassa settings for card binding returnUrl fallback
ALLOWED_PAYMENT_RETURN_URL=https://lastochki.store
SESSION_DB_PATH=.data/sessions.sqlite
# Production: 64 random hex characters. Never commit the real value.
SESSION_ENCRYPTION_KEY=
# Set to true once the payment return domain is verified in YooKassa merchant dashboard
CHECKOUT_ENABLED=true

