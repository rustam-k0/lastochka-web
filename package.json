{
  "name": "lastochka-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "npm run build && node --import tsx scripts/test-server.ts scripts/e2e.mjs",
    "test:responsive": "npm run build && node --import tsx scripts/test-server.ts scripts/responsive.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node --import tsx server/index.ts",
    "db:backup": "node --import tsx server/backup.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.7",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
